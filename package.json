{
  "name": "gorizont",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:fuzz": "vitest run --mode fuzz",
    "e2e": "playwright test",
    "data:building": "node scripts/gen-building.mjs && prettier --write src/data/building.json"
  },
  "dependencies": {
    "@react-three/drei": "9.114.0",
    "@react-three/fiber": "8.17.10",
    "konva": "9.3.16",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-konva": "18.2.10",
    "react-router-dom": "6.28.0",
    "three": "0.170.0",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "9.15.0",
    "@playwright/test": "1.49.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.0.1",
    "@types/node": "22.10.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "eslint": "9.15.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "eslint-plugin-react-refresh": "0.4.14",
    "globals": "15.12.0",
    "jsdom": "25.0.1",
    "postcss": "8.4.49",
    "prettier": "3.4.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "typescript-eslint": "8.16.0",
    "vite": "5.4.11",
    "vitest": "2.1.6"
  }
}
